# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Every variable is validated by src/lib/env.schema.ts.

# Convex (required). `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Shared write secret; must match the Convex env var of the same name. Required in production.
KIDZCOOP_CONVEX_WRITE_TOKEN=

# Clerk (optional). Leave both empty to run without sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Set this one in the Convex dashboard, not here: CLERK_JWT_ISSUER_DOMAIN

# Brevo (optional): newsletter list and login-failure alert emails.
BREVO_API_KEY=
BREVO_LIST_ID=
ALERT_SENDER_EMAIL=contact@kidzcoop.app

# Optional
NEXT_PUBLIC_SITE_URL=https://kidzcoop.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
